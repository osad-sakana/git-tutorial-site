---
interface Props {
  title?: string
  filename?: string
  class?: string
}
const { title = 'ターミナル', filename, class: className } = Astro.props
const isFile = !!filename
---

<div class:list={['rounded-xl border overflow-hidden terminal-block', className]}>
  <div class="bg-white/5 px-4 py-2 border-b border-white/10 text-xs text-gray-400 font-mono flex items-center gap-2">
    {!isFile && (
      <>
        <span class="w-3 h-3 rounded-full bg-red-500/60"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/60"></span>
        <span class="w-3 h-3 rounded-full bg-green-500/60"></span>
        <span class="ml-2 flex-1">{title}</span>
      </>
    )}
    {isFile && <span class="flex-1">{filename}</span>}
    <button
      class="copy-btn hover:text-white transition-colors px-2.5 py-1 rounded-md hover:bg-white/10 text-xs shrink-0"
      aria-label="コードをコピー"
    >コピー</button>
  </div>
  <pre class="p-6 text-sm font-mono leading-relaxed overflow-x-auto"><slot /></pre>
</div>

<script>
  // 「$ コマンド」の行があればコマンドだけを、なければ全文をコピーする（貼り付けてそのまま実行できるように）
  const extract = (text: string): string => {
    const cmds = text
      .split('\n')
      .filter((line) => /^\$ /.test(line.trim()))
      .map((line) => line.trim().replace(/^\$ /, ''))
    return (cmds.length ? cmds.join('\n') : text).trim()
  }

  document.querySelectorAll('.terminal-block').forEach((block) => {
    const btn = block.querySelector('.copy-btn') as HTMLButtonElement | null
    const pre = block.querySelector('pre') as HTMLPreElement | null
    btn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(extract(pre?.textContent ?? ''))
        if (btn) {
          btn.textContent = '✓ コピー済み'
          setTimeout(() => { btn.textContent = 'コピー' }, 2000)
        }
      } catch {
        // clipboard API not available
      }
    })
  })
</script>
