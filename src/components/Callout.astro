---
import Icon from './Icon.astro'

interface Props {
  type?: 'tip' | 'warn' | 'info' | 'danger'
  title?: string
}
const { type = 'info', title } = Astro.props

const styles = {
  tip:    { icon: 'lightbulb',      label: 'ポイント', box: 'bg-emerald-50/80 border-emerald-200', bar: 'bg-emerald-500', text: 'text-emerald-700' },
  warn:   { icon: 'triangle-alert', label: '注意',     box: 'bg-amber-50/80 border-amber-200',     bar: 'bg-amber-500',   text: 'text-amber-700' },
  info:   { icon: 'info',           label: '補足',     box: 'bg-sky-50/80 border-sky-200',         bar: 'bg-sky-500',     text: 'text-sky-700' },
  danger: { icon: 'shield-check',   label: '重要',     box: 'bg-red-50/80 border-red-200',         bar: 'bg-red-500',     text: 'text-red-700' },
}[type]
---

<aside class={`relative overflow-hidden rounded-xl border pl-5 pr-5 py-4 my-6 text-sm leading-relaxed text-gray-700 ${styles.box}`}>
  <span class={`absolute left-0 inset-y-0 w-1 ${styles.bar}`}></span>
  <p class={`flex items-center gap-1.5 font-bold mb-1.5 ${styles.text}`}>
    <Icon name={styles.icon} size={16} />
    {title ?? styles.label}
  </p>
  <div class="[&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-orange-700 [&_code]:bg-white/80 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:border [&_code]:border-orange-200">
    <slot />
  </div>
</aside>
