---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const { title, description = 'GitとGitHubの使い方を初心者向けにわかりやすく解説します' } = Astro.props

const base = import.meta.env.BASE_URL
const currentPath = Astro.url.pathname

const navLinks = [
  { href: base,                      label: 'ホーム' },
  { href: `${base}what-is-git`,      label: 'Gitとは？' },
  { href: `${base}basics`,           label: 'Git 基本' },
  { href: `${base}undo`,             label: '取り消し' },
  { href: `${base}branch`,           label: 'ブランチ' },
  { href: `${base}about-github`,     label: 'GitHub とは' },
  { href: `${base}github`,           label: 'GitHub 基本' },
  { href: `${base}pullrequest`,      label: 'プルリクエスト' },
  { href: `${base}workflow`,         label: 'ワークフロー' },
  { href: `${base}issue-driven`,     label: 'Issue 駆動' },
]

function isActive(href: string): boolean {
  const normalHref    = href.endsWith('/') && href.length > 1 ? href.slice(0, -1) : href
  const normalCurrent = currentPath.endsWith('/') && currentPath.length > 1
    ? currentPath.slice(0, -1)
    : currentPath
  return normalCurrent === normalHref
}

const ogTitle = `${title} | Git & GitHub 入門`
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{ogTitle}</title>

    <!-- OGP -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Git & GitHub 入門" />
    <meta property="og:title"       content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={Astro.url.href} />
    <meta name="twitter:card"       content="summary" />
    <meta name="twitter:title"      content={ogTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="bg-slate-50 text-gray-900 min-h-screen font-sans">

    <!-- ヘッダー -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3">

        <!-- ロゴ -->
        <a href={base} class="flex items-center gap-2 hover:opacity-80 transition-opacity shrink-0">
          <div class="w-8 h-8 bg-orange-500 rounded-lg flex items-center justify-center text-white font-bold text-xs">
            Git
          </div>
          <span class="text-base font-bold text-gray-900 hidden sm:block">Git & GitHub 入門</span>
        </a>

        <!-- デスクトップナビ -->
        <nav class="hidden md:flex items-center gap-0.5 flex-1 overflow-x-auto">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              class={isActive(href)
                ? 'bg-orange-50 text-orange-600 font-semibold px-2.5 py-1.5 rounded-lg text-xs whitespace-nowrap'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 px-2.5 py-1.5 rounded-lg text-xs whitespace-nowrap transition-colors'}
            >{label}</a>
          ))}
        </nav>

        <!-- ハンバーガーボタン（モバイルのみ） -->
        <button
          id="hamburger-btn"
          class="md:hidden ml-auto flex flex-col justify-center items-center w-10 h-10 gap-1.5 rounded-lg hover:bg-gray-100 transition-colors shrink-0"
          aria-label="メニューを開く"
          aria-expanded="false"
        >
          <span class="hamburger-line block w-5 h-0.5 bg-gray-600 transition-all duration-300"></span>
          <span class="hamburger-line block w-5 h-0.5 bg-gray-600 transition-all duration-300"></span>
          <span class="hamburger-line block w-5 h-0.5 bg-gray-600 transition-all duration-300"></span>
        </button>
      </div>

      <!-- モバイルメニュー -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
        <nav class="max-w-6xl mx-auto px-4 py-3 flex flex-col">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              class={isActive(href)
                ? 'bg-orange-50 text-orange-600 font-semibold px-3 py-2.5 rounded-lg text-sm'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50 transition-colors px-3 py-2.5 rounded-lg text-sm'}
            >{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main>
      <slot />
    </main>

    <!-- フッター -->
    <footer class="bg-white border-t border-gray-200 mt-20 py-10">
      <div class="max-w-6xl mx-auto px-4 text-center text-gray-400 text-sm">
        <p>Git & GitHub 入門ガイド — 初心者のためのバージョン管理学習サイト</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('hamburger-btn')
      const menu = document.getElementById('mobile-menu')
      const lines = btn?.querySelectorAll('.hamburger-line')

      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden')
        if (isOpen) {
          menu?.classList.add('hidden')
          btn.setAttribute('aria-expanded', 'false')
          if (lines) {
            ;(lines[0] as HTMLElement).style.transform = ''
            ;(lines[1] as HTMLElement).style.opacity = '1'
            ;(lines[2] as HTMLElement).style.transform = ''
          }
        } else {
          menu?.classList.remove('hidden')
          btn.setAttribute('aria-expanded', 'true')
          if (lines) {
            ;(lines[0] as HTMLElement).style.transform = 'translateY(8px) rotate(45deg)'
            ;(lines[1] as HTMLElement).style.opacity = '0'
            ;(lines[2] as HTMLElement).style.transform = 'translateY(-8px) rotate(-45deg)'
          }
        }
      })

      document.querySelectorAll('#mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => {
          menu?.classList.add('hidden')
          btn?.setAttribute('aria-expanded', 'false')
          if (lines) {
            ;(lines[0] as HTMLElement).style.transform = ''
            ;(lines[1] as HTMLElement).style.opacity = '1'
            ;(lines[2] as HTMLElement).style.transform = ''
          }
        })
      })
    </script>
  </body>
</html>
